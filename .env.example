# Copy this file to .env and fill in the required credentials.
# Optional values may be omitted or left empty when using Docker Compose.

# -----------------------------------------------------------------------------
# Required credentials
# -----------------------------------------------------------------------------

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Spotify application credentials from the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Proxies and cookies (optional)
# -----------------------------------------------------------------------------

# Proxy URL for media providers, e.g. http://user:password@host:port.
MEDIA_PROXY=

# Proxy URL for Telegram, e.g. socks5://user:password@host:port.
TELEGRAM_PROXY=

# Cookies file name, e.g. cookies.txt (not a host path).
# The file must exist in /app/data inside the container.
# Compose mounts ./data at /app/data.
COOKIES_FILE=

# -----------------------------------------------------------------------------
# Bot settings (optional; defaults shown)
# -----------------------------------------------------------------------------

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Maximum number of Spotify search results: 1-10.
SEARCH_LIMIT=5

# Maximum upload size in MB: at least 1.
MAX_UPLOAD_SIZE_MB=49

# Chat ID used to cache inline media, e.g. -1001234567890.
# Leave empty to use the requesting user's chat.
INLINE_CACHE_CHAT_ID=
